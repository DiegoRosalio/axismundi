# Maintainer: Diego Rosalio <diegorosalio19 at gmail dot com>
#
# Builds axismundi from a git checkout, like the AUR's -git packages. By default it uses the repository this
# PKGBUILD lives in (packaging/arch/ -> ../..), so in your clone:
#     cd packaging/arch && makepkg -si
# To build from a server instead, set _repo, e.g. _repo="git@gitbro:axismundi.git" (git+ssh) or an https URL.

pkgname=axismundi-git
_name=axismundi
pkgver=r0.0000000
pkgrel=1
pkgdesc="Interactive 3D visualizer for linear algebra, calculus and complex numbers"
arch=('x86_64' 'aarch64')
# url="": add the project's page here when it has a public home
license=('GPL-3.0-or-later' 'OFL-1.1')
depends=('raylib>=5.5' 'gcc-libs' 'glibc' 'hicolor-icon-theme')
makedepends=('git' 'clang')
optdepends=('texlive-basic: compile LaTeX figure exports to PDF from the app'
            'texlive-pictures: PGFPlots/TikZ for the exported figures'
            'texlive-latexextra: the standalone class for exported figures')
provides=("$_name")
conflicts=("$_name")
_repo="${_repo:-$(cd "$startdir/../.." 2>/dev/null && pwd)}"
_branch="${_branch:-claude}"
source=("$_name::git+file://$_repo#branch=$_branch")
sha256sums=('SKIP')

pkgver() {
    cd "$_name"
    printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

build() {
    cd "$_name"
    # makepkg's flags (from /etc/makepkg.conf) plus what the project needs
    make build CXX=clang++ CXXFLAGS="$CXXFLAGS -std=c++20" LDFLAGS="$LDFLAGS"
}

check() {
    cd "$_name"
    make test CXX=clang++ CXXFLAGS="$CXXFLAGS -std=c++20" LDFLAGS="$LDFLAGS"
}

package() {
    cd "$_name"
    # The binary as /usr/bin/axismundi, the desktop entry, the icons and the fonts' licenses
    make install DESTDIR="$pkgdir" PREFIX=/usr
    # Arch keeps a package's licenses under its own name
    mv "$pkgdir/usr/share/licenses/$_name" "$pkgdir/usr/share/licenses/$pkgname"
}
